<Window x:Class="PodEdit.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PodEdit" Width="1040" Height="720" MinWidth="820" MinHeight="600"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource ForegroundBrush}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="PodEdit" FontSize="32" FontWeight="SemiBold" />
      <TextBlock Text="Offline neural multicamera podcast editor" Foreground="{DynamicResource MutedBrush}" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,22,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Camera 1 · master audio" Margin="0,0,0,5" />
        <TextBox x:Name="Camera1Box" Height="34" Padding="8" AutomationProperties.Name="Camera 1 video path" />
        <TextBlock x:Name="Camera1Info" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
      </StackPanel>
      <Button Grid.Column="1" Content="Browse…" Click="BrowseCamera1_Click" VerticalAlignment="Bottom" />
    </Grid>

    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Camera 2" Margin="0,0,0,5" />
        <TextBox x:Name="Camera2Box" Height="34" Padding="8" AutomationProperties.Name="Camera 2 video path" />
        <TextBlock x:Name="Camera2Info" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
      </StackPanel>
      <Button Grid.Column="1" Content="Browse…" Click="BrowseCamera2_Click" VerticalAlignment="Bottom" />
    </Grid>

    <Grid Grid.Row="3" Margin="0,12,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="150" /><ColumnDefinition Width="170" />
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="Output folder" Margin="0,0,0,5" />
        <TextBox x:Name="OutputBox" Height="34" Padding="8" AutomationProperties.Name="Output folder path" />
      </StackPanel>
      <Button Grid.Column="1" Content="Browse…" Click="BrowseOutput_Click" VerticalAlignment="Bottom" />
      <StackPanel Grid.Column="2" Margin="8,0,12,0">
        <TextBlock Text="Minutes" Margin="0,0,0,5" />
        <TextBox x:Name="MinutesBox" Text="25" Height="34" Padding="8" AutomationProperties.Name="Episode duration in minutes" />
      </StackPanel>
      <StackPanel Grid.Column="3">
        <TextBlock Text="Editorial profile" Margin="0,0,0,5" />
        <ComboBox x:Name="ProfileBox" SelectedIndex="1" Height="34">
          <ComboBoxItem Content="conservative" /><ComboBoxItem Content="balanced" />
          <ComboBoxItem Content="responsive" />
        </ComboBox>
        <CheckBox x:Name="PreviewCheckBox" Content="Render preview and cut review"
                  IsChecked="False" Margin="0,8,0,0"
                  ToolTip="Optional: review media takes additional processing time and disk space." />
      </StackPanel>
    </Grid>

    <Border Grid.Row="4" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="14">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel>
          <DockPanel>
            <TextBlock x:Name="StatusText" Text="Ready" FontWeight="SemiBold" />
            <TextBlock x:Name="TimingText" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" />
          </DockPanel>
          <ProgressBar x:Name="Progress" Height="7" Margin="0,9,0,12" Minimum="0" Maximum="1" />
        </StackPanel>
        <TextBox Grid.Row="1" x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" Background="{DynamicResource LogBrush}" Foreground="{DynamicResource LogForegroundBrush}"
                 BorderThickness="0" FontFamily="Consolas" FontSize="12" Padding="10" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="ShowTimelineButton" Content="Show timeline" Click="ShowTimeline_Click" IsEnabled="False" />
      <Button x:Name="PlayPreviewButton" Content="Play preview" Click="PlayPreview_Click" IsEnabled="False" />
      <Button x:Name="ThemeButton" Content="Light theme" Click="Theme_Click" />
      <Button Content="Swap cameras" Click="SwapCameras_Click" />
      <Button x:Name="OpenOutputButton" Content="Open output" Click="OpenOutput_Click" IsEnabled="False" />
      <Button x:Name="PreflightButton" Content="Check setup" Click="Preflight_Click" />
      <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False" />
      <Button x:Name="StartButton" Content="Start edit" Click="Start_Click" Background="{StaticResource AccentBrush}" />
    </StackPanel>
  </Grid>
</Window>
