<Application x:Class="PodEdit.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#171C26" />
    <SolidColorBrush x:Key="AccentBrush" Color="#56C7FF" />
    <SolidColorBrush x:Key="WindowBrush" Color="#0D1118" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#EDF5FF" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9CB0C7" />
    <SolidColorBrush x:Key="LogBrush" Color="#0A0E14" />
    <SolidColorBrush x:Key="LogForegroundBrush" Color="#BFE6FF" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="MinWidth" Value="90" />
    </Style>
  </Application.Resources>
</Application>
